# SessionManagerService — variables interpoladas en config.json
# (Redis se configura en el `.env` de la raíz.)

# JWT (provider security/jwt); mín. 32 caracteres, solo si no se usa rotación de claves
JWT_SECRET=

# OAuth providers
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Overrides de dominio (vacío = default por entorno: localhost en dev, adigitalcafe.com en prod)
SESSION_COOKIE_DOMAIN=.adigitalcafe.com
SESSION_DEFAULT_REDIRECT_URL=

# Introspección de tokens (RFC 7662, `POST /api/auth/introspect`) para backends externos.
# JSON: [{"clientId":"sumi","secretSha256":"<sha256 hex del secreto>","resources":["sumi"]}]
# Vacío = endpoint deshabilitado (404). Guardarlo como secreto administrado o en env/secrets.env.
# Dev (secreto `sumi-dev-secret`):
# ADC_INTROSPECTION_CLIENTS=[{"clientId":"sumi","secretSha256":"a4c78129d066bb48b093416e00f349b5f4de60a5c641d1ae6d2c445dc8629915","resources":["sumi"]}]
ADC_INTROSPECTION_CLIENTS=
